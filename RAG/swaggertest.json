{
  "openapi": "3.0.0",
  "info": {
    "title": "Core Communication Platform",
    "version": "1.0.0",
    "description": "Enterprise APIs for managing messages and transactional operations."
  },
  "paths": {
    "/v1/messages/send": {
      "post": {
        "summary": "Send SMS Message",
        "description": "Dispatches an instantaneous text message or verification code to a global phone number.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "recipient_phone": {
                    "type": "string",
                    "description": "E.164 formatted target phone number."
                  },
                  "body_text": {
                    "type": "string",
                    "description": "The textual body content of the sms payload."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful delivery dispatch.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message_id": {
                      "type": "string",
                      "description": "Unique alphanumeric delivery tracking identifier."
                    },
                    "delivery_status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
