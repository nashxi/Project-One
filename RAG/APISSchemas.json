  {
    "api_id": "api_004",
    "title": "Twilio SMS API",
    "description": "Programmatically send text messages and automated verification codes.",
    "category": "Communication",
    "tags": ["sms", "otp", "phone"],
    "request_schema": {
      "to_phone_number": "string (E.164 format international phone number)",
      "message_body": "string (text content max 160 characters)",
